#!/usr/bin/env python3
"""No provider key is committed, enforced at the commit instead of remembered.

A key in the history is a key that has to be rotated. This hook is the
only thing standing between an OpenRouter key and a push.

It refuses a key and nothing else. It does not refuse a document by its
extension, so a real `.dwg` or `.xlsx` may be committed as a test
fixture.

pre-commit passes the staged paths as arguments. Run it by hand the same
way:

    bin/no-secrets some/file.py

Exit 0 means every path is allowed. Exit 1 names what is wrong.
"""

from __future__ import annotations

import pathlib
import re
import sys

# A real OpenRouter key is the v1 prefix and a long token. The bare
# prefix is not worth matching: this repository's own history discusses
# it in prose, and an earlier version of this check failed on those
# mentions until it was narrowed to a key shape.
#
# The literal is split across two adjacent strings so that this file does
# not carry the prefix it searches for. A history scan run before a push
# would otherwise find the hook itself.
KEY_PATTERN = re.compile(rb"sk-" rb"or-[A-Za-z0-9_-]{24,}")

WHAT_TO_DO = (
    "A key belongs in .env, which git ignores. Rotate it if it has "
    "already been shared. --no-verify is not the answer."
)


def refusals(paths: list[str]) -> list[str]:
    """Return one line per reason to refuse. An empty list means allow."""
    found: list[str] = []
    for name in paths:
        path = pathlib.Path(name)
        try:
            content = path.read_bytes()
        except OSError:
            # A path pre-commit staged and then removed. Nothing to read
            # and nothing to refuse.
            continue
        if KEY_PATTERN.search(content):
            found.append(
                f"{name}: this holds something shaped like an OpenRouter "
                f"API key."
            )
    return found


def main(argv: list[str]) -> int:
    found = refusals(argv[1:])
    if not found:
        return 0
    print("no-secrets refuses this commit:", file=sys.stderr)
    for line in found:
        print(f"  {line}", file=sys.stderr)
    print(f"\n{WHAT_TO_DO}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
