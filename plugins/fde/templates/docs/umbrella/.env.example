# Copy to `.env`. Compose reads this file, from the umbrella root, for
# variable interpolation in all three included compose files.

# Postgres's host port. 5433 is fde-be's own default; change it to run a
# second stack.
DB_PORT=5433

# Redis's host port. 6380 is fde-be's own default.
REDIS_PORT=6380

# Django's host port, published by the `be` service.
BE_PORT=8000

# The Vite dev server's host port, published by the `fe` service.
FE_PORT=8100

# Caddy's host port. The whole stack is reached at http://localhost on
# this port; 80 needs no `:port` in the browser.
PROXY_PORT=80

# The origin the frontend calls. Point it at the proxy above.
VITE_API_URL=http://localhost

# Read by `just seed`; set it in the environment or here, never commit a
# real value.
SEED_PASSWORD=
